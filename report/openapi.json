    "/api/v1/reports/search-latest": {
      "get": {
        "tags": [
          "搜索"
        ],
        "summary": "Search Latest Reports",
        "description": "跨类型检索并按发布时间排序的最新报告列表\n\n- **market**: CN/HK\n- **stock_code**: 股票代码（CN 6位 / HK 5位）\n- **report_types**: 可重复参数或逗号分隔字符串\n- **max_count**: 最大返回数量 (1-50)",
        "operationId": "search_latest_reports_api_v1_reports_search_latest_get",
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(CN|HK)$",
              "description": "市场: CN/HK",
              "title": "Market"
            },
            "description": "市场: CN/HK"
          },
          {
            "name": "stock_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "股票代码",
              "title": "Stock Code"
            },
            "description": "股票代码"
          },
          {
            "name": "report_types",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "报告类型列表，支持 annual/semi_annual/quarterly/all",
              "title": "Report Types"
            },
            "description": "报告类型列表，支持 annual/semi_annual/quarterly/all"
          },
          {
            "name": "max_count",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "description": "最大返回数量",
              "default": 10,
              "title": "Max Count"
            },
            "description": "最大返回数量"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIResponse_Dict_str__Any__"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
